    if (DP.isMatch())
      return MCTargetAsmParser::Match_Success;
    if (DP.isNearMatch())
      return AArch64AsmParser::Match_InvalidCondCode;
    break;
    }
  // 'Extend64' class
  case MCK_Extend64: {
    DiagnosticPredicate DP(Operand.isExtend64());
    if (DP.isMatch())
      return MCTargetAsmParser::Match_Success;
    if (DP.isNearMatch())
