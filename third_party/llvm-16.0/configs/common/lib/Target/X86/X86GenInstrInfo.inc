    CEFBS_None, // XSAVEC = 17790
    CEFBS_In64BitMode, // XSAVEC64 = 17791
    CEFBS_None, // XSAVEOPT = 17792
    CEFBS_In64BitMode, // XSAVEOPT64 = 17793
    CEFBS_None, // XSAVES = 17794
    CEFBS_In64BitMode, // XSAVES64 = 17795
    CEFBS_None, // XSETBV = 17796
    CEFBS_None, // XSHA1 = 17797
    CEFBS_None, // XSHA256 = 17798
    CEFBS_None, // XSTORE = 17799
    CEFBS_None, // XSUSLDTRK = 17800
    CEFBS_None, // XTEST = 17801
  };

  assert(Opcode < 17802);
  FeatureBitset AvailableFeatures = computeAvailableFeatures(Features);
  const FeatureBitset &RequiredFeatures = FeatureBitsets[RequiredFeaturesRefs[Opcode]];
  FeatureBitset MissingFeatures =
      (AvailableFeatures & RequiredFeatures) ^
      RequiredFeatures;
  if (MissingFeatures.any()) {
    std::ostringstream Msg;
    Msg << "Attempting to emit " << &X86InstrNameData[X86InstrNameIndices[Opcode]]
        << " instruction but the ";
    for (unsigned i = 0, e = MissingFeatures.size(); i != e; ++i)
      if (MissingFeatures.test(i))
        Msg << SubtargetFeatureNames[i] << " ";
    Msg << "predicate(s) are not met";
    report_fatal_error(Msg.str().c_str());
  }
#endif // NDEBUG
}
} // end namespace X86_MC
} // end namespace llvm
#endif // ENABLE_INSTR_PREDICATE_VERIFIER

